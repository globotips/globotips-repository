# PostgreSQL URL. SQLite file:./dev.db is not supported (it does not persist on Vercel).
# Laptop (no Docker): paste a Neon / Vercel Postgres connection string, or a local
# Postgres URL if you already have Postgres on this machine (Postgres.app, Homebrew,
# or the installer). Example local shape — replace USER, PASSWORD, and the db name:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/globotips"

# Signs the hotel admin session cookie. Use any long random string locally.
SESSION_SECRET="local-demo-session-secret-change-me"

# Seeded Tampa hotel login (also documented in the README)
DEMO_HOTEL_EMAIL="tampa@globotips.com"
DEMO_HOTEL_PASSWORD="tampa-demo"

# Encoded into downloaded QR PNGs. Displayed links always use globotips.com.
# For a phone that should open this machine, set this to your local origin.
TIP_QR_ORIGIN="https://globotips.com"

# Stripe TEST MODE (laptop / preview). Leave unset to keep the local demo checkout (no charges).
# NEVER put sk_live_ / pk_live_ in a file that can be committed.
# Live keys are rejected unless STRIPE_MODE=live AND NODE_ENV=production (host env only).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_CONNECT_CLIENT_ID="ca_..."

# --- Production on globotips.com (Vercel project globotips, team globo-tips) ---
# Set these on the host. Do not put live key values or DB credentials in this file
# or any other git file.
#
# NODE_ENV=production
# STRIPE_MODE=live
# SESSION_SECRET=
# DATABASE_URL=                 # postgresql://... from Neon / Vercel Postgres
#                               # Set in the Vercel project env (Production, and
#                               # Preview if preview deploys should hit a database).
#                               # After the URL is set, apply the schema once from a
#                               # machine that has that URL: npx prisma db push
#                               # Do not commit the URL. Do not run db:seed on
#                               # production unless you want the Tampa demo hotel.
# TIP_QR_ORIGIN=https://www.globotips.com
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=
#
# Live Account Link return/refresh and Checkout success/cancel URLs are
# https://www.globotips.com/... (never localhost).
# Stripe webhook endpoint: https://www.globotips.com/api/webhooks/stripe
