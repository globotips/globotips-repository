generator client {
  provider = "prisma-client-js"
}

// PostgreSQL for the laptop demo and Vercel production.
// DATABASE_URL must be postgresql://... (Neon, Vercel Postgres, or local Postgres).
// SQLite file:./dev.db is not supported — it does not persist on Vercel serverless.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  employees    Employee[]
}

model Employee {
  id               String   @id @default(cuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name             String
  tipCode          String   @unique
  stripeAccountId  String?  @unique
  detailsSubmitted Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  tips             Tip[]
}

model Tip {
  id                      String   @id @default(cuid())
  employeeId              String
  employee                Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountCents             Int
  platformFeeCents        Int      @default(0)
  status                  String   @default("paid")
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?
  createdAt               DateTime @default(now())
}
